# --- Server Settings ---
GATEWAY_HOST=gateway.myserver.com
GATEWAY_PORT=443
WEBUI_PORT=8080
WEBUI_DOMAIN=localhost

TUNNEL_HOST=tunnel.myserver.com
TUNNEL_PORT=9443

# --- JWT Auth ---
JWT_SECRET=supersecretjwtkey

# --- ACME / Let's Encrypt ---
ACME_ENABLE=false
ACME_CACHE=./cert-cache
ACME_ENV=production # production | staging
ACME_PORT=80 # optional default 80

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASS=
REDIS_DB=0
DOMAIN_REDIS_DB=1

# --- Wildcard Domain ---
# e.g. *.yourdomain.com
WILDCARD_DOMAIN=*.example.com

# --- Postgres ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=gotunnel
