# --- Server Settings ---
GATEWAY_DOMAIN=gateway.myserver.com
GATEWAY_PORT=8443
WEBUI_PORT=8080
WEBUI_DOMAIN=webui.myserver.com
CLI_LATEST_VERSION=dev

PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

TUNNEL_DOMAIN=tunnel.myserver.com
TUNNEL_PORT=9443

# --- JWT Auth ---
JWT_SECRET=supersecretjwtkey
WEB_JWT_EXPIRE_HOURS=24
CLI_JWT_EXPIRE_HOURS=720

# --- ACME / Let's Encrypt ---
ACME_ENABLE=false
ACME_CACHE=./cert-cache
ACME_ENV=production # production | staging

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASS=
REDIS_DB=0
DOMAIN_REDIS_DB=1

# --- Wildcard Domain ---
# e.g. *.yourdomain.com
WILDCARD_DOMAIN=*.example.com
# If you manually register Let's Encrypt for wildcard domains, specify the certs here:
WILDCARD_CERT_PATH=/etc/letsencrypt/live/example.com/fullchain.pem
WILDCARD_KEY_PATH=/etc/letsencrypt/live/example.com/privkey.pem

# --- Postgres ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=gotunnel
