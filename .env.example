# --- Server Settings ---
GATEWAY_HOST=gateway.myserver.com
GATEWAY_PORT=443
WEBUI_PORT=8080

TUNNEL_HOST=tunnel.myserver.com
TUNNEL_PORT=9443

# --- JWT Auth ---
